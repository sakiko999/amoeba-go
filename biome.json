{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/out",
      "!**/node_modules",
      "!**/release",
      "!tmp",
      "!old",
      "!components/platform-douyin/abogus.js",
      "!components/platform-douyin/testdata",
      "!components/page-player-h5/src/renderer/src/player"
    ]
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "formatter": {
    "enabled": false
  },
  "linter": {
    "enabled": true
  },
  "overrides": [
    {
      "includes": ["web/ui/src/components/**", "web/ui/src/hooks/**"],
      "linter": {
        "enabled": false
      }
    }
  ]
}
