{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/out",
      "!**/node_modules",
      "!**/release",
      "!tmp",
      "!packages/amoeba",
      "!packages/rss-service/runtime",
      "!packages/platform-rss-*/src/impl",
      "!packages/platform-rss-*/src/lib",
      "!packages/platform-rss-*/src/example",
      "!packages/rss-subscriptions/src/example"
    ]
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "formatter": {
    "enabled": false
  },
  "linter": {
    "enabled": true
  },
  "overrides": [
    {
      "includes": ["packages/ui/src/components/**", "packages/ui/src/hooks/**"],
      "linter": {
        "enabled": false
      }
    }
  ]
}
