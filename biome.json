{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/out",
      "!**/node_modules",
      "!**/page-dist",
      "!**/release",
      "!apps/desktop/pages",
      "!tmp"
    ]
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "formatter": {
    "enabled": false
  },
  "linter": {
    "enabled": true
  },
  "overrides": [
    {
      "includes": ["packages/ui/src/components/**", "packages/ui/src/hooks/**"],
      "linter": {
        "enabled": false
      }
    }
  ]
}
