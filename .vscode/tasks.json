{
  "version": "2.0.0",
  "tasks": [
    {
      // 只构建前端（chrome + 页面组件）：dlv 调试的 preLaunchTask，
      // Go 侧由调试器自己编译启动，脚本不掺和 go
      "label": "build: 前端",
      "type": "shell",
      "command": "bun run scripts/build.ts fe",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      // 宿主 dev（前端构建 + go run .）；关窗即退出
      "label": "dev: 宿主",
      "type": "shell",
      "command": "bun run dev",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "build: 宿主",
      "type": "shell",
      "command": "bun run build",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "test: go",
      "type": "shell",
      "command": "go test ./...",
      "options": { "cwd": "${workspaceFolder}" }
    }
  ]
}
