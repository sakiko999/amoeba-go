{
  "version": "0.2.0",
  "configurations": [
    {
      // mygo 宿主调试（需 VS Code Go 扩展 + delve）：先跑 tasks.json 的
      // "build: 前端"（dlv 自己编译 Go，前端必须先就位），再从模块根启动。
      // cwd 必须是仓库根：-pages/-vendor 的运行时默认值按相对路径发现。
      "name": "宿主 (dlv)",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "build: 前端"
    }
  ]
}
