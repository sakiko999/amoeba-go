{
  "version": "0.2.0",
  "configurations": [
    {
      // 启动时自动跑 tasks.json 的 dev: desktop（inspector 9229 + renderer 9333）
      // 不设 restart：关窗即断（electron-vite 随 Electron 退出）；改主进程触发热重启后重新 F5
      "type": "node",
      "request": "attach",
      "name": "Desktop: Main (9229)",
      "preLaunchTask": "dev: desktop",
      "port": 9229,
      "address": "127.0.0.1",
      "skipFiles": ["<node_internals>/**"],
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/apps/desktop/out/main/**/*.js"]
    },
    {
      // host 页面与各静态 tab 的 renderer；attach 后 VS Code 会让你选 target
      // 不单独配 preLaunchTask（避免与 Desktop: Main 重复启动），用组合配置或先跑 dev: desktop
      // webRoot 是仓库根：dev URL 是 http://localhost:5173/<源路径>
      "type": "chrome",
      "request": "attach",
      "name": "Desktop: Renderer (9333)",
      "port": 9333,
      "address": "127.0.0.1",
      "webRoot": "${workspaceFolder}",
      "sourceMaps": true
    },
    {
      // 启动时自动跑 tasks.json 的 dev: media（独立 media-manager，inspector 9230）
      // 同样不设 restart：关窗即断，热重启主进程后重新 F5
      "type": "node",
      "request": "attach",
      "name": "Media Manager: Main (9230)",
      "preLaunchTask": "dev: media",
      "port": 9230,
      "address": "127.0.0.1",
      "skipFiles": ["<node_internals>/**"],
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/packages/media-manager/out/main/**/*.js"]
    }
  ],
  "compounds": [
    {
      "name": "Desktop: Main + Renderer",
      "configurations": ["Desktop: Main (9229)", "Desktop: Renderer (9333)"]
    }
  ]
}
