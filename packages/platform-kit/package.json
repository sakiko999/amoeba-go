  "scripts": {
    "test": "bun test"
  },
  "dependencies": {
    "ws": "^8.21.3"
  },
  "peerDependencies": {
    "electron": ">=45"
  },
  "devDependencies": {
    "@host/sdk": "workspace:*",
    "@tabs/platform-contracts": "workspace:*",
    "@types/ws": "^8.18.1"
  }
