{
  "name": "electron-tabs-demo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "bun run pages:prepare && bun run --cwd apps/desktop build",
    "dev": "bun run --cwd apps/desktop dev",
    "smoke": "bun run build && bun run --cwd apps/desktop smoke",
    "pages:prepare": "bun run --cwd packages/media-manager pack:page",
    "media": "bun run --cwd packages/media-manager dev",
    "media:debug": "bun run --cwd packages/media-manager dev:debug",
    "media:build": "bun run --cwd packages/media-manager build",
    "media:smoke": "bun run media:build && bun run --cwd packages/media-manager smoke",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "fmt": "bun fmt ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/bun": "^1.4.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@types/node": "^24"
  }
}
